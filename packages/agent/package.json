{
  "name": "@aura/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./strands": {
      "types": "./dist/strands.d.ts",
      "default": "./dist/strands.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aura/application": "workspace:*",
    "@aura/contracts": "workspace:*",
    "@aura/domain": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@opentelemetry/api": "1.9.0",
    "@strands-agents/sdk": "1.20.0",
    "openai": "6.45.0",
    "zod": "4.1.12"
  }
}
