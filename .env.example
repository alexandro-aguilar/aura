AGENT_MODE=mock
DATABASE_PATH=./data/aura.sqlite
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Only needed for AGENT_MODE=openai; never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Home Assistant backend; independent of AGENT_MODE. Empty write grants stay read-only.
DEVICE_BACKEND=mock
HA_URL=
HA_TOKEN=
HA_LIGHT_IDS=
HA_WRITE_LIGHT_IDS=
HA_TIMEOUT_MS=5000
HA_CONFIRMATION_TIMEOUT_MS=3000

# Speech is independent of AGENT_MODE. Mock recognizes “status” and plays a tone.
SPEECH_MODE=mock
SPEECH_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
SPEECH_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
SPEECH_VOICE=coral
SPEECH_LANGUAGE=en
SPEECH_TIMEOUT_MS=30000
# Optional headless satellite credential (32–128 random URL-safe characters).
# Configure the same secret on the API and satellite; never in VITE_* variables.
SATELLITE_TOKEN=
# Satellite-only settings; HTTP is restricted to loopback. Use SSH tunnels remotely.
AURA_API_URL=http://127.0.0.1:3001
ALSA_CAPTURE_DEVICE=default
ALSA_PLAYBACK_DEVICE=default

# Memory is configured in Settings or POST /preferences/control, not here.
# MVP4 automation server switch: leave off until accepted.
AUTOMATIONS_ENABLED=false
AUTOMATION_POLL_MS=5000
# Wake settings and PICOVOICE_ACCESS_KEY belong ONLY in .env.voice-satellite.
