AGENT_MODE=mock
DATABASE_PATH=./data/aura.sqlite
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Only needed for AGENT_MODE=openai; never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Home Assistant backend; independent of AGENT_MODE. Empty write grants stay read-only.
DEVICE_BACKEND=mock
HA_URL=
HA_TOKEN=
HA_LIGHT_IDS=
HA_WRITE_LIGHT_IDS=
HA_TIMEOUT_MS=5000
HA_CONFIRMATION_TIMEOUT_MS=3000
